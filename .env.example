NODE_ENV=development
PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://homespace:homespace@localhost:5432/homespace

# Auth0 tenant or custom domain, API Identifier, and SPA client ID.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.homespace.local
AUTH0_CLIENT_ID=your-auth0-spa-client-id

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=homespace-local
S3_ACCESS_KEY_ID=homespace
S3_SECRET_ACCESS_KEY=homespace-local-secret
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600
