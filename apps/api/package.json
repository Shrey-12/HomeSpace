{
  "name": "@homespace/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @homespace/contracts build && pnpm --filter @homespace/database build",
    "prebuild": "pnpm --filter @homespace/contracts build && pnpm --filter @homespace/database build",
    "pretypecheck": "pnpm --filter @homespace/contracts build && pnpm --filter @homespace/database build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-presigned-post": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/cors": "^10.0.2",
    "@homespace/contracts": "workspace:*",
    "@homespace/database": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
