{
  "name": "homespace",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @homespace/api dev",
    "dev:worker": "pnpm --filter @homespace/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @homespace/database db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
